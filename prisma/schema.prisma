// Prisma schema — AlquiLibres data layer (Vercel Postgres)
// The full data model (10 tables + enums + indexes) is added in the
// "schema" work unit. This minimal skeleton exists so `prisma generate`
// can bootstrap the client during infrastructure setup.
//
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
