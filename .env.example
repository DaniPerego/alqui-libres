# ============================================================
# AlquiLibres — Environment Variables (template)
# Copy to `.env` locally and set real values. Vercel uses the
# same variable names in Project → Settings → Environment Variables.
# NEVER commit real credentials.
# ============================================================

# --- Database (Vercel Postgres / any Postgres) ---
# Prisma connects to this URL. For Vercel Postgres use the pooled URL
# (the one including ?sslmode=require&pgbouncer=true) or the direct URL.
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# --- Supabase Auth ---
# Project URL and keys from Supabase Dashboard → Project Settings → API.
# ANON_KEY is public (safe for the SPA). SERVICE_ROLE_KEY is secret and
# must NEVER be exposed to the browser — only used server-side (seed, admin).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Vercel Blob (existing image uploads, api/upload.js) ---
# From Vercel Dashboard → Storage → Blob → tokens.
BLOB_READ_WRITE_TOKEN=your_blob_read_write_token

# --- Frontend (Vite, exposed to the browser with VITE_ prefix) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Payment Gateway public key (MercadoPago checkout, existing frontend)
VITE_PAYMENT_PUBLIC_KEY=your_payment_public_key
