{
  "name": "alqui-libres",
  "version": "1.0.0",
  "description": "Plataforma hiper-local de alquileres temporarios con modelo de suscripción",
  "author": "AlquiLibres Team",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "prisma": "prisma",
    "seed": "prisma db seed",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "deploy": "npm run build && firebase deploy",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:rules": "firebase deploy --only firestore:rules,storage",
    "deploy:preview": "npm run build && firebase hosting:channel:deploy preview",
    "deploy:all": "npm run build && firebase deploy --only hosting,functions,firestore:rules",
    "functions:install": "cd functions && npm install",
    "functions:serve": "firebase emulators:start --only functions",
    "functions:logs": "firebase functions:log",
    "firebase:login": "firebase login",
    "firebase:init": "firebase init"
  },
  "dependencies": {
    "@mercadopago/sdk-js": "^0.0.3",
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.111.0",
    "@vercel/blob": "^2.6.1",
    "@vueuse/core": "^10.7.0",
    "firebase": "^10.7.1",
    "pinia": "^2.1.7",
    "vue": "^3.4.0",
    "vue-datepicker-next": "^1.0.3",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.11",
    "dotenv": "^16.6.1",
    "happy-dom": "^15.11.7",
    "jsdom": "^25.0.1",
    "prisma": "^6.19.3",
    "terser": "^5.44.1",
    "vite": "^5.0.0",
    "vitest": "^3.2.7"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "alquileres",
    "rentals",
    "vacation-rentals",
    "short-term-rentals",
    "vue",
    "firebase",
    "spa"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/DaniPerego/alqui-libres.git"
  }
}
